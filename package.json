{
  "name": "docker_web_app",
  "version": "1.0.0",
  "description": "Node.js on Docker",
  "author": "First Last <first.last@example.com>",
  "main": "server.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "tsc --build ./client"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "chokidar": "^5.0.0",
    "dotenv": "^16.0.0",
    "eslint": "^10.7.0",
    "express": "^4.18.2",
    "globals": "^17.7.0",
    "kicad_svg_parser": "github:SpaceTeam/kicad_svg_parser",
    "node-fetch": "^2.7.0",
    "socket.io": "^2.5.1",
    "typescript": "^7.0.2",
    "undici-types": "^8.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "client/**/*",
      "server/**/*"
    ],
    "ignore": [
      "client/ts_built/**/*"
    ],
    "ext": "js,ts,json",
    "exec": "tsc --build client; node server.js"
  }
}
